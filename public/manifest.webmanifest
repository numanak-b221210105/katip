{
  "name": "Kâtip — cihazında konuşmadan yazıya",
  "short_name": "Kâtip",
  "description": "On-device speech-to-text notebook. Audio never leaves your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f1e7",
  "theme_color": "#f6f1e7",
  "lang": "tr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Yeni kayıt / New recording",
      "url": "./#/"
    },
    {
      "name": "Notlar / Notes",
      "url": "./#/notes"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/*",
            ".ogg",
            ".opus",
            ".oga",
            ".m4a",
            ".mp3",
            ".wav",
            ".webm",
            ".aac",
            ".amr"
          ]
        }
      ]
    }
  }
}
